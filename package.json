{
  "name": "asistencia",
  "version": "0.1.0",
  "private": true,
  "description": "Gestion de eventos, formularios publicos de asistencia y reportes.",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:api": "wrangler dev apps/api/src/index.ts --config apps/api/wrangler.toml --local --port 8787",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run build:web",
    "build:worker": "wrangler deploy --dry-run",
    "build:cloudflare": "npm run typecheck && npm run build && npm run build:worker",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "preview:web": "vite preview --host 0.0.0.0",
    "db:migrate:local": "wrangler d1 migrations apply asistencia-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply asistencia-db --remote",
    "deploy:api": "wrangler deploy",
    "deploy:web": "wrangler pages deploy apps/web/dist --project-name asistencia",
    "deploy": "npm run build && npm run deploy:api && npm run deploy:web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pantezana/asistencia.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "hono": "^4.13.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0"
  }
}
